# ==========================================
# China PD Monthly Report - .gitignore
# ==========================================
# 排除敏感数据、API key、临时文件
# 不要修改本文件除非你清楚后果
# ==========================================

# ---- API key & 凭证(绝对不能上 public repo)----
claude_api_key.txt
*.key
*.pem
.env
.env.*

# ---- 数据源 xlsx(内部 PD 数据,不公开)----
China PD updates *.xlsx
Project list.xlsx
Summers_Monthly_PD_Table*.xlsx
*.xlsm

# ---- HTML 备份版本(只保留最新)----
*_prev.html

# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器临时文件 ----
.~lock.*
~$*
*.swp
*.swo

# ---- IDE 配置 ----
.vscode/
.idea/

# ---- 推送 token / 凭证(绝对不能上 public repo,2026-06-01 补)----
*Token.txt
*token.txt
*.token
PMO HTML*.txt

# ---- 数据源 xlsx: 带日期后缀的也要排除(2026-06-01 补)----
Project list*.xlsx

# ---- 兜底: 所有 xlsx 都是内部数据,一律不上 repo(2026-07-02 补)----
*.xlsx

# ---- 本地历史归档不上 repo(旧报告在 git 历史里都有,2026-07-02 补)----
Archive/

# ---- 其它(以后想排除的随手加这里)----
